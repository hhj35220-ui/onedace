generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  USER
  SUPER_ADMIN
}

enum TeamMemberRole {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENT
  TASK_ATTACHMENT
  TASK_COMPLETED
  TASK_DUE
  CHECKLIST_COMPLETED
  LABEL_ADDED
  TIME_ENTRY
  DEPENDENCY_ADDED
}

enum PlatformType {
  WHATSAPP
  GMAIL
  INSTAGRAM
  TIKTOK
  X
  LINKEDIN
}

enum PlatformConnectionStatus {
  DISCONNECTED
  CONNECTING
  QR_READY
  CONNECTED
  RECONNECTING
  ERROR
}

enum WhatsAppSessionStatus {
  DISCONNECTED
  CONNECTING
  QR_READY
  CONNECTED
  RECONNECTING
  ERROR
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppEventType {
  SESSION_STATUS
  QR_READY
  MESSAGE_RECEIVED
  MESSAGE_SENT
  CONTACT_SYNCED
  CHAT_SYNCED
  GROUP_SYNCED
  PRESENCE_UPDATED
  TYPING_UPDATED
  ERROR
}

enum SyncStateStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                      String          @id @default(uuid()) @db.Uuid
  email                   String          @unique @db.VarChar(320)
  password                String          @db.VarChar(255)
  firstName               String          @db.VarChar(100)
  lastName                String          @db.VarChar(100)
  avatar                  String?
  phone                   String?         @db.VarChar(24)
  role                    UserRole        @default(USER)
  isActive                Boolean         @default(true)
  emailVerified           Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  organizations           Organization[]
  refreshTokens           RefreshToken[]
  teamMembers             TeamMember[]
  createdProjects         Project[]
  createdTasks            Task[]          @relation("TaskCreator")
  assignedTasks           Task[]          @relation("TaskAssignee")
  comments                Comment[]
  activities              Activity[]
  attachments             Attachment[]
  completedChecklistItems ChecklistItem[] @relation("ChecklistItemCompletedBy")
  timeEntries             TimeEntry[]
  notifications           Notification[]
  recurringTasks          RecurringTask[]
  auditLogs               AuditLog[]
  platformConnections     PlatformConnection[]

  @@map("users")
}

model PlatformConnection {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @db.Uuid
  userId            String                  @db.Uuid
  platformType      PlatformType            @default(WHATSAPP)
  status            PlatformConnectionStatus @default(DISCONNECTED)
  displayName       String?                 @db.VarChar(255)
  metadata          Json?
  lastSeenAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUser         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  whatsappSessions  WhatsAppSession[]

  @@map("platform_connections")
}

model WhatsAppSession {
  id                  String               @id @default(uuid()) @db.Uuid
  platformConnectionId String              @db.Uuid
  organizationId      String               @db.Uuid
  sessionKey          String               @unique @db.VarChar(255)
  phoneNumber         String?              @db.VarChar(32)
  displayName         String?              @db.VarChar(255)
  status              WhatsAppSessionStatus @default(DISCONNECTED)
  qrCodeUrl           String?
  lastConnectedAt     DateTime?
  lastSeenAt          DateTime?
  lastError           String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  platformConnection  PlatformConnection   @relation(fields: [platformConnectionId], references: [id], onDelete: Cascade)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chats               WhatsAppChat[]
  contacts            WhatsAppContact[]
  messages            WhatsAppMessage[]
  events              WhatsAppEvent[]
  syncStates          SyncState[]

  @@map("whatsapp_sessions")
}

model WhatsAppChat {
  id                String           @id @default(uuid()) @db.Uuid
  whatsappSessionId String           @db.Uuid
  externalChatId    String           @db.VarChar(255)
  chatName          String?          @db.VarChar(255)
  chatType          String?          @db.VarChar(50)
  unreadCount       Int              @default(0)
  archived          Boolean          @default(false)
  lastMessageAt     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  whatsappSession   WhatsAppSession  @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)
  messages          WhatsAppMessage[]

  @@unique([whatsappSessionId, externalChatId])
  @@map("whatsapp_chats")
}

model WhatsAppContact {
  id                String           @id @default(uuid()) @db.Uuid
  whatsappSessionId String           @db.Uuid
  externalContactId String           @db.VarChar(255)
  name              String?          @db.VarChar(255)
  phoneNumber       String?          @db.VarChar(32)
  profilePictureUrl String?
  isBlocked         Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  whatsappSession   WhatsAppSession  @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)
  messages          WhatsAppMessage[]

  @@unique([whatsappSessionId, externalContactId])
  @@map("whatsapp_contacts")
}

model WhatsAppMessage {
  id                 String           @id @default(uuid()) @db.Uuid
  whatsappSessionId  String           @db.Uuid
  chatId             String?          @db.Uuid
  contactId          String?          @db.Uuid
  externalMessageId  String?          @db.VarChar(255)
  direction          MessageDirection
  messageType        String           @db.VarChar(50)
  content            String?          @db.Text
  status             MessageStatus    @default(PENDING)
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  whatsappSession    WhatsAppSession  @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)
  chat               WhatsAppChat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)
  contact            WhatsAppContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([whatsappSessionId, externalMessageId])
  @@map("whatsapp_messages")
}

model WhatsAppEvent {
  id                String             @id @default(uuid()) @db.Uuid
  whatsappSessionId String             @db.Uuid
  eventType         WhatsAppEventType
  severity          String             @db.VarChar(20)
  payload           Json
  processed         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  whatsappSession   WhatsAppSession    @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)

  @@map("whatsapp_events")
}

model SyncState {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  whatsappSessionId String?          @db.Uuid
  resourceType      String           @db.VarChar(50)
  cursor            String?          @db.VarChar(255)
  status            SyncStateStatus  @default(IDLE)
  lastSyncedAt      DateTime?
  lastError         String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappSession   WhatsAppSession? @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)

  @@map("sync_states")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(255)
  message        String           @db.Text
  entityType     String           @db.VarChar(100)
  entityId       String           @db.VarChar(100)
  metadata       Json?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model CalendarIntegration {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  provider           String    @db.VarChar(20)
  externalCalendarId String?   @db.VarChar(255)
  accessToken        String?   @db.Text
  refreshToken       String?   @db.Text
  tokenExpiresAt     DateTime?
  syncEnabled        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@map("calendar_integrations")
}

model CalendarSyncLog {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @db.Uuid
  taskId        String   @db.Uuid
  action        String   @db.VarChar(20)
  status        String   @db.VarChar(20)
  message       String?  @db.Text
  syncedAt      DateTime @default(now())

  @@map("calendar_sync_logs")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  entityType     String       @db.VarChar(30)
  entityId       String       @db.VarChar(100)
  action         String       @db.VarChar(20)
  metadata       Json?
  ipAddress      String?      @db.VarChar(45)
  userAgent      String?      @db.Text
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Label {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(30)
  color          String       @db.VarChar(7)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskLabels     TaskLabel[]

  @@map("labels")
}

model Organization {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(100)
  slug          String         @unique @db.VarChar(100)
  description   String?
  logoUrl       String?
  ownerId       String         @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teams         Team[]
  projects      Project[]
  labels        Label[]
  notifications Notification[]
  auditLogs     AuditLog[]
  platformConnections PlatformConnection[]
  whatsappSessions WhatsAppSession[]
  syncStates    SyncState[]

  @@map("organizations")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(100)
  description    String?
  color          String?      @db.VarChar(24)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  teamMembers    TeamMember[]
  projects       Project[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("teams")
}

model TeamMember {
  id        String         @id @default(uuid()) @db.Uuid
  teamId    String         @db.Uuid
  userId    String         @db.Uuid
  role      TeamMemberRole @default(MEMBER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  teamId         String?         @db.Uuid
  name           String          @db.VarChar(100)
  description    String?         @db.Text
  status         ProjectStatus   @default(PLANNING)
  priority       ProjectPriority @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  createdBy      String          @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  creator        User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  tasks          Task[]

  @@map("projects")
}

model Task {
  id               String           @id @default(uuid()) @db.Uuid
  projectId        String           @db.Uuid
  creatorId        String           @db.Uuid
  assigneeId       String?          @db.Uuid
  name             String           @db.VarChar(100)
  description      String?          @db.Text
  status           TaskStatus       @default(TODO)
  priority         TaskPriority     @default(MEDIUM)
  dueDate          DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator          User             @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee         User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments         Comment[]
  activities       Activity[]
  attachments      Attachment[]
  taskLabels       TaskLabel[]
  checklists       Checklist[]
  timeEntries      TimeEntry[]
  taskDependencies TaskDependency[] @relation("TaskDependencies")
  dependsOnTasks   TaskDependency[] @relation("TaskDependsOn")
  recurringTasks   RecurringTask[]

  @@map("tasks")
}

model Checklist {
  id        String          @id @default(uuid()) @db.Uuid
  taskId    String          @db.Uuid
  title     String          @db.VarChar(100)
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]

  @@map("checklists")
}

model ChecklistItem {
  id              String    @id @default(uuid()) @db.Uuid
  checklistId     String    @db.Uuid
  content         String    @db.VarChar(300)
  completed       Boolean   @default(false)
  position        Int       @default(0)
  completedAt     DateTime?
  completedBy     String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  checklist       Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedByUser User?     @relation("ChecklistItemCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)

  @@map("checklist_items")
}

model TaskLabel {
  taskId    String   @db.Uuid
  labelId   String   @db.Uuid
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model RecurringTask {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @db.Uuid
  userId    String    @db.Uuid
  interval  Int       @default(1)
  frequency String    @default("daily") @db.VarChar(20)
  nextRunAt DateTime
  lastRunAt DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recurring_tasks")
}

model TaskDependency {
  id              String    @id @default(uuid()) @db.Uuid
  taskId          String    @db.Uuid
  dependsOnTaskId String    @db.Uuid
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  task            Task      @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task      @relation("TaskDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model TimeEntry {
  id              String    @id @default(uuid()) @db.Uuid
  taskId          String    @db.Uuid
  userId          String    @db.Uuid
  description     String?   @db.VarChar(500)
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("time_entries")
}

model Attachment {
  id           String    @id @default(uuid()) @db.Uuid
  taskId       String    @db.Uuid
  uploadedBy   String    @db.Uuid
  originalName String    @db.VarChar(255)
  fileName     String    @db.VarChar(255)
  mimeType     String    @db.VarChar(100)
  fileSize     Int
  filePath     String    @db.VarChar(500)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader     User      @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @db.Uuid
  userId    String    @db.Uuid
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  action    String   @db.VarChar(100)
  metadata  Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique @db.VarChar(512)
  userId    String    @db.Uuid
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
