<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TikTok — OnePlace Enterprise</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css">
  <link rel="stylesheet" href="../css/styles.css?v=20260721">
  <link rel="stylesheet" href="../css/dashboard.css">
  <link rel="stylesheet" href="../css/tiktok.css?v=20260721">
</head>
<body>
  <div class="dashboard-layout">
    <aside class="dashboard-sidebar" role="navigation" aria-label="TikTok sidebar"></aside>
    <div class="sidebar-overlay"></div>

    <main class="dashboard-main">
      <header class="dashboard-header" role="banner"></header>
      <div class="dashboard-content" id="tiktok-content">
        <div style="padding:24px;background:#fff;border:1px solid #e2e8f0;border-radius:16px;box-shadow:0 8px 24px rgba(15,23,42,0.06);">
          <h1 style="margin:0 0 8px;font-size:24px;font-weight:700;color:#0f172a;">TikTok Overview</h1>
          <p style="margin:0 0 16px;font-size:14px;color:#64748b;">Loading your TikTok workspace…</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;">
            <div style="padding:16px;border-radius:12px;background:#f8fafc;border:1px solid #e2e8f0;">Conversations</div>
            <div style="padding:16px;border-radius:12px;background:#f8fafc;border:1px solid #e2e8f0;">Comments</div>
            <div style="padding:16px;border-radius:12px;background:#f8fafc;border:1px solid #e2e8f0;">Mentions</div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    window.OP = {
      auth: {
        getSession: () => ({ fullName: 'Alex Morgan', email: 'alex@oneplace.com' }),
        requireAuth: () => true,
        signOut: () => { localStorage.clear(); window.location.href = 'signin.html'; }
      },
      theme: {
        toggle: () => {
          const html = document.documentElement;
          const current = html.getAttribute('data-theme');
          html.setAttribute('data-theme', current === 'dark' ? 'light' : 'dark');
        }
      },
      toast: {
        show: (msg, type = 'info', duration = 3000) => {
          console.log(`[${type}] ${msg}`);
        }
      },
      loading: { show: () => {}, hide: () => {} },
      nav: { requireAuth: () => true }
    };
  </script>
  <script src="../js/app.js"></script>
  <script src="../js/storage.js"></script>
  <script src="../js/tiktok.js?v=20260721"></script>
</body>
</html>