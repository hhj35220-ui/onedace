[debug] [2026-08-13T23:37:52.616Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/oneplace-c3ac8/rulesets {"name":"projects/oneplace-c3ac8/rulesets/77348e2b-d626-4c1e-b885-b0df55b2d509","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isSelfUser(uid) {\r\n      return signedIn() && uid == request.auth.uid;\r\n    }\r\n\r\n    function workspaceMember(workspaceId) {\r\n      return signedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));\r\n    }\r\n\r\n    function workspaceOwner(workspaceId) {\r\n      return workspaceMember(workspaceId) && get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role == 'owner';\r\n    }\r\n\r\n    match /users/{uid} {\r\n      allow read: if isSelfUser(uid);\r\n      allow create: if isSelfUser(uid);\r\n      allow update: if isSelfUser(uid);\r\n      allow delete: if false;\r\n    }\r\n\r\n    match /workspaces/{workspaceId} {\r\n      allow read: if workspaceMember(workspaceId);\r\n      allow create: if signedIn();\r\n      allow update: if workspaceOwner(workspaceId);\r\n      allow delete: if workspaceOwner(workspaceId);\r\n\r\n      match /members/{uid} {\r\n        allow read: if workspaceMember(workspaceId);\r\n        allow create: if signedIn() && uid == request.auth.uid;\r\n        allow update: if workspaceOwner(workspaceId) || (signedIn() && uid == request.auth.uid && resource.data.role != 'owner');\r\n        allow delete: if workspaceOwner(workspaceId) || (signedIn() && uid == request.auth.uid && resource.data.role != 'owner');\r\n      }\r\n\r\n      match /{document=**} {\r\n        allow read: if workspaceMember(workspaceId);\r\n        allow create, update, delete: if workspaceOwner(workspaceId);\r\n      }\r\n    }\r\n\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-08-13T23:37:52.169263Z","metadata":{"services":["cloud.firestore"]}}
